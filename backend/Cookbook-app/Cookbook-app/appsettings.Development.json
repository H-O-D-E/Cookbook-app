{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    // REVIEW(config): a real password committed to a public repo. It is only a local database, but this is the exact habit that leaks a production credential later. Use dotnet user-secrets (the UserSecretsId is already in the csproj, so the wiring is done) or environment variables.
    // REVIEW(azure): because the connection string exists only in the Development file, the app works on your laptop and cannot start anywhere else. See the note in appsettings.json.
    "ConnectionStrings": {
      "DefaultConnection": "Host=localhost;Port=5432;Database=cookbook;Username=cookbook;Password=hodehodehode"
    },

  // REVIEW(good): Jwt:IssuerSigningKey is deliberately not in either file and comes from user-secrets, and Program.cs fails fast when it is missing. That is the right instinct. Write down in the README where it is meant to come from in each environment.
  "Jwt": {
    "ValidIssuer": "CookbookApi",
    "ValidAudience": "CookbookClient"
  }
}
